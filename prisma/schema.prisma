datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  OWNER
  AGENT
  ADMIN
}

enum TransactionType {
  RENT
  SALE
  LEASE
}

enum PropertyType {
  APARTMENT
  INDEPENDENT_HOUSE
  VILLA
  STUDIO_APARTMENT
  PENTHOUSE
  BUILDER_FLOOR
  RESIDENTIAL_PLOT
  FARM_HOUSE
  PG
  CO_LIVING
  SHARED_ROOM
  OFFICE_SPACE
  COWORKING_SPACE
  SHOP
  SHOWROOM
  WAREHOUSE
  INDUSTRIAL_PROPERTY
  COMMERCIAL_LAND
  DEVELOPER_SITE
  PLOT
  AGRICULTURE_LAND
  RESORT
  INDUSTRIAL_SITE
  INDUSTRIAL_BUILDING
  HOTEL
  COMMERCIAL_COMPLEX
}

enum PropertyStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  RENTED
  SOLD
  LEASED
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  VISIT_SCHEDULED
  CLOSED
  SPAM
}

enum VisitStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

enum VisitType {
  IN_PERSON
  VIDEO_TOUR
}

enum ReportReason {
  FAKE_PROPERTY
  INCORRECT_INFORMATION
  DUPLICATE_LISTING
  ALREADY_SOLD_OR_RENTED
  SUSPICIOUS_OWNER
  SPAM
  OTHER
}

enum NotificationType {
  ENQUIRY
  VISIT_BOOKED
  VISIT_CONFIRMED
  VISIT_REJECTED
  VISIT_RESCHEDULED
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  PROPERTY_STATUS_CHANGED
  MESSAGE_RECEIVED
  ADMIN_ALERT
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum PossessionStatus {
  UNDER_CONSTRUCTION
  READY_TO_MOVE
}

enum OwnershipType {
  FREEHOLD
  LEASEHOLD
  CO_OPERATIVE
  POWER_OF_ATTORNEY
}

enum FacingDirection {
  EAST
  WEST
  NORTH
  SOUTH
  NORTHEAST
  NORTHWEST
  SOUTHEAST
  SOUTHWEST
}

enum AreaUnit {
  SQFT
  SQYRD
  ACRE
}

enum TenantPreference {
  BACHELORS
  FAMILY
  COMPANY
  ANY
  VEG
  NON_VEG
}

enum PropertyImageCategory {
  EXTERIOR
  INTERIOR
  BEDROOM
  BATHROOM
  KITCHEN
  PLAN
}

model User {
  id                     String           @id @default(uuid())
  customId               String?          @unique
  email                  String           @unique
  passwordHash           String
  plainPassword          String?
  name                   String
  phone                  String?
  role                   Role             @default(USER)
  avatar                 String?
  isEmailVerified        Boolean          @default(false)
  isApproved             Boolean          @default(false)
  isSuspended            Boolean          @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  properties             Property[]       @relation("OwnerProperties")
  enquiries              Enquiry[]
  visits                 Visit[]          @relation("UserVisits")
  sentMessages           Message[]        @relation("SentMessages")
  rcvdMessages           Message[]        @relation("ReceivedMessages")
  conversations          Conversation[]   @relation("ConversationParticipants")
  notifications          Notification[]
  reports                PropertyReport[]
  recentlyViewed         RecentlyViewed[]
  reviewsWritten         Review[]         @relation("ReviewsWritten")
  favourites             Favourite[]
  agentProfile           AgentProfile?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([email])
  @@index([role])
}

model AgentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String?
  experienceYears Int?
  licenseNumber   String?
  bio             String?
  ratingAverage   Float    @default(0.0)
  isFeatured      Boolean  @default(true)
  reviews         Review[] @relation("AgentReviews")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model City {
  id         String     @id @default(uuid())
  name       String     @unique
  slug       String     @unique
  localities Locality[]
  properties Property[]
  createdAt  DateTime   @default(now())
}

model Locality {
  id         String     @id @default(uuid())
  name       String
  slug       String
  cityId     String
  city       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  properties Property[]
  createdAt  DateTime   @default(now())

  @@unique([name, cityId])
  @@index([cityId])
}

model Amenity {
  id         String            @id @default(uuid())
  name       String            @unique
  icon       String?
  properties PropertyAmenity[]
  createdAt  DateTime          @default(now())
}

model Property {
  id                 String           @id @default(uuid())
  title              String
  slug               String           @unique
  description        String
  transactionType    TransactionType
  propertyType       PropertyType
  price              Decimal          @db.Decimal(15, 2)
  monthlyRent        Decimal?         @db.Decimal(12, 2)
  securityDeposit    Decimal?         @db.Decimal(12, 2)
  maintenanceCharges Decimal?         @db.Decimal(10, 2)
  leaseDuration      Int? // in months
  priceNegotiable    Boolean          @default(false)

  // Configuration
  bhk        Int?
  bedrooms   Int?
  bathrooms  Int?
  balconies  Int?
  totalRooms Int?

  // Areas
  carpetArea       Int
  builtUpArea      Int?
  superBuiltUpArea   Int?
  plotArea         Int?
  areaUnit         AreaUnit @default(SQFT)

  // Building details
  floorNumber      Int?
  totalFloors      Int?
  propertyAge      Int? // in years
  possessionStatus PossessionStatus
  availableFrom    DateTime?
  facing           FacingDirection?
  furnishingStatus FurnishingStatus

  // Parking
  coveredParking Int @default(0)
  openParking    Int @default(0)

  // Preferences / Legal
  ownershipType    OwnershipType
  tenantPreference TenantPreference @default(ANY)
  listedBy         String?          // OWNER, AGENT, TENANT
  videoUrl         String?
  saleType         String?          // FULL_HOUSE, FLOOR_WISE

  // Location Details
  country     String   @default("India")
  state       String
  cityId      String
  city        City     @relation(fields: [cityId], references: [id])
  localityId  String
  locality    Locality @relation(fields: [localityId], references: [id])
  fullAddress String
  landmark    String?
  pincode     String
  latitude    Float?
  longitude   Float?

  // Compliance
  reraId         String?
  isReraApproved Boolean @default(false)

  // Status & Verification
  isVerified      Boolean        @default(false)
  isFeatured      Boolean        @default(false)
  status          PropertyStatus @default(DRAFT)
  rejectionReason String?
  viewCount       Int            @default(0)

  // Owner relations
  ownerId String
  owner   User   @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)

  // Normalized relations
  images         PropertyImage[]
  amenities      PropertyAmenity[]
  enquiries      Enquiry[]
  visits         Visit[]
  reports        PropertyReport[]
  favourites     Favourite[]
  recentlyViewed RecentlyViewed[]
  conversations  Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionType])
  @@index([propertyType])
  @@index([cityId])
  @@index([localityId])
  @@index([price])
  @@index([bedrooms])
  @@index([status])
  @@index([ownerId])
  @@index([isFeatured])
  @@index([createdAt])
}

model PropertyImage {
  id         String                @id @default(uuid())
  propertyId String
  property   Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  publicId   String?
  altText    String?
  category   PropertyImageCategory @default(EXTERIOR)
  isPrimary  Boolean               @default(false)
  sortOrder  Int                   @default(0)
  createdAt  DateTime              @default(now())

  @@index([propertyId])
  @@index([isPrimary])
}

model PropertyAmenity {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
}

model Enquiry {
  id         String        @id @default(uuid())
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String
  message    String
  status     EnquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([propertyId])
  @@index([senderId])
  @@index([status])
  @@index([createdAt])
}

model Visit {
  id         String      @id @default(uuid())
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitorId  String
  visitor    User        @relation("UserVisits", fields: [visitorId], references: [id], onDelete: Cascade)
  date       DateTime
  timeSlot   String
  status     VisitStatus @default(PENDING)
  type       VisitType   @default(IN_PERSON)
  message    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([propertyId])
  @@index([visitorId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
}

model Conversation {
  id         String     @id @default(uuid())
  propertyId String?
  property   Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  participants User[]   @relation("ConversationParticipants")
  messages   Message[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([propertyId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Review {
  id             String       @id @default(uuid())
  reviewerId     String
  reviewer       User         @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  agentProfileId String
  agentProfile   AgentProfile @relation("AgentReviews", fields: [agentProfileId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String
  createdAt      DateTime     @default(now())

  @@unique([reviewerId, agentProfileId])
  @@index([agentProfileId])
  @@index([reviewerId])
}

model PropertyReport {
  id         String       @id @default(uuid())
  propertyId String
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String
  createdAt  DateTime     @default(now())

  @@index([propertyId])
  @@index([reporterId])
  @@index([createdAt])
}

model RecentlyViewed {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewedAt   DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@index([viewedAt])
}

model Favourite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// ─────────────────────────────────────────
// ADDS BUZZ (ADVERTISEMENTS)
// ─────────────────────────────────────────

enum AdPlacement {
  HOME_ONLY
  INNER_ONLY
  BOTH
  PROPERTIES_ONLY
  PROPERTY_DETAIL_ONLY
}

enum AdFormat {
  FULL_WIDTH
  HALF_WIDTH
  QUAD_GRID
}

model Advertisement {
  id           String      @id @default(uuid())
  name         String
  imageUrl     String
  targetUrl    String
  placement    AdPlacement @default(BOTH)
  format       AdFormat    @default(FULL_WIDTH)
  isExclusive  Boolean     @default(false)
  isActive     Boolean     @default(true)
  displayOrder Int         @default(0)
  clickCount   Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([placement])
  @@index([isActive])
  @@index([displayOrder])
  @@index([isExclusive])
}

